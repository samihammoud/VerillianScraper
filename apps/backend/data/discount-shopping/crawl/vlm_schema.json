{
  "type": "object",
  "required": ["summary", "hook", "transcript", "on_screen_text", "format",
               "format_traits", "setting", "topics", "products", "entities",
               "audio", "creator_on_camera", "cta", "presentation_facets", "confidence"],
  "propertyOrdering": ["summary", "hook", "transcript", "on_screen_text", "format",
                       "format_traits", "setting", "topics", "products", "entities",
                       "audio", "creator_on_camera", "cta", "presentation_facets", "confidence"],
  "properties": {
    "summary": {"type": "string",
                "description": "One sentence: what happens in the video."},
    "hook": {"type": "string", "nullable": true,
             "description": "Verbatim spoken line and/or on-screen text in the first 3 seconds."},
    "transcript": {"type": "string", "nullable": true,
                   "description": "Verbatim spoken words in order. null if no speech."},
    "on_screen_text": {"type": "array", "items": {"type": "string"},
                       "description": "Every distinct text overlay, verbatim, in order."},

    "format": {"type": "string",
               "description": "2-4 words, lowercase noun phrase, for how the video is constructed - not what it is about. Examples: 'voiceover product demo', 'green screen reaction', 'silent before after', 'unboxing haul'."},
    "format_traits": {"type": "array", "items": {"type": "string"},
                      "description": "0-3 further 1-3 word lowercase traits. Examples: 'fast cuts', 'trending audio', 'text only', 'asmr', 'split screen', 'single take'."},
    "setting": {"type": "string",
                "description": "2-4 words, lowercase noun phrase. Examples: 'thrift store aisle', 'apartment floor', 'grocery clearance rack'."},
    "topics": {"type": "array", "items": {"type": "string"},
               "description": "2-5 subjects of the video, each a 2-4 word lowercase noun phrase."},

    "products": {
      "type": "array",
      "description": "Physical products shown or named. Empty if none.",
      "items": {
        "type": "object",
        "required": ["name", "brand", "prominence", "first_seen_sec", "value_signal"],
        "propertyOrdering": ["name", "brand", "prominence", "first_seen_sec", "value_signal"],
        "properties": {
          "name": {"type": "string",
                   "description": "2-4 words, lowercase noun phrase for the object itself, no brand. Examples: 'wool trench coat', 'cast iron skillet'."},
          "brand": {"type": "string", "nullable": true,
                    "description": "Only if legible on screen or spoken aloud. Never inferred."},
          "prominence": {"type": "string", "enum": ["hero", "incidental"]},
          "first_seen_sec": {"type": "number"},
          "value_signal": {
            "type": "object",
            "required": ["acquisition_cost", "stated_value_usd", "value_gap_called_out"],
            "propertyOrdering": ["acquisition_cost", "stated_value_usd", "value_gap_called_out"],
            "properties": {
              "acquisition_cost": {"type": "string",
                                   "enum": ["free", "deep_discount", "discount", "full_price", "not_stated"],
                                   "description": "What the creator paid for this specific item. free = explicitly $0 (curb, giveaway, sample, won). deep_discount = a specific low price framed as a steal. discount = a stated sale/clearance price. full_price = explicitly paid retail. not_stated = cost never addressed."},
              "stated_value_usd": {"type": "number", "nullable": true,
                                   "description": "The retail/worth value the creator states or displays for this item. null if no value is stated."},
              "value_gap_called_out": {"type": "boolean",
                                       "description": "true if the creator states or displays both a cost and a worth for the same item, spoken or on-screen."}
            }
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "required": ["people", "brands", "places", "organizations"],
      "propertyOrdering": ["people", "brands", "places", "organizations"],
      "properties": {
        "people": {"type": "array", "items": {"type": "string"},
                   "description": "Named people mentioned or shown, verbatim. Not the creator unless named."},
        "brands": {"type": "array", "items": {"type": "string"},
                   "description": "Brands named aloud or legible on screen, verbatim."},
        "places": {"type": "array", "items": {"type": "string"},
                   "description": "Cities, countries, regions, or venues named or clearly shown by signage, verbatim."},
        "organizations": {"type": "array", "items": {"type": "string"},
                          "description": "Companies, clinics, shelters, retailers named, verbatim."}
      }
    },
    "audio": {
      "type": "object",
      "required": ["kind", "spoken_language", "speaker_count"],
      "propertyOrdering": ["kind", "spoken_language", "speaker_count"],
      "properties": {
        "kind": {"type": "string",
                 "enum": ["direct_speech", "voiceover", "music_only", "ambient", "silent"]},
        "spoken_language": {"type": "string", "nullable": true,
                            "description": "BCP-47 code of the speech, e.g. 'en', 'es'. null if no speech."},
        "speaker_count": {"type": "integer"}
      }
    },
    "creator_on_camera": {"type": "boolean"},
    "cta": {"type": "string",
            "enum": ["comment", "tag_someone", "share", "link_in_bio", "follow", "shop_now", "none"],
            "description": "'tag_someone' covers 'tag your person', 'send this to him'."},

    "presentation_facets": {
      "type": "object",
      "description": "How the video is made, independent of what it shows. Seven independent facets; answer each one for every video.",
      "required": ["reveal_structure", "camera_framing", "text_overlay_style",
                   "audio_delivery", "tone_register", "value_framing",
                   "authenticity_markers"],
      "propertyOrdering": ["reveal_structure", "camera_framing", "text_overlay_style",
                           "audio_delivery", "tone_register", "value_framing",
                           "authenticity_markers"],
      "properties": {
        "reveal_structure": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase, how the video is paced toward the item."},
            "choice": {"type": "string", "enum": ["cold_open", "build_then_reveal", "before_after", "single_item_deep_dive", "rapid_fire_haul", "other", "n/a"]}
          }},
        "camera_framing": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase."},
            "choice": {"type": "string", "enum": ["handheld_pov", "tripod_grwm", "flat_lay_overhead", "mirror_shot", "screen_recording", "other", "n/a"]}
          }},
        "text_overlay_style": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase."},
            "choice": {"type": "string", "enum": ["native_caption", "imported_screenshot_style", "narration_subtitles", "no_text", "other", "n/a"]}
          }},
        "audio_delivery": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase."},
            "choice": {"type": "string", "enum": ["voiceover_explanation", "trending_audio_lipsync", "ambient_product_sound", "silent_text_only", "other", "n/a"]}
          }},
        "tone_register": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase."},
            "choice": {"type": "string", "enum": ["hype_disbelief", "deadpan_understatement", "informative_educational", "storytelling", "other", "n/a"]}
          }},
        "value_framing": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase, how price or worth is narrated in the video."},
            "choice": {"type": "string", "enum": ["price_stated_onscreen", "price_stated_verbally", "implied_no_number", "not_addressed", "other", "n/a"]}
          }},
        "authenticity_markers": {"type": "object", "required": ["text", "choice"],
          "propertyOrdering": ["text", "choice"], "properties": {
            "text": {"type": "string", "description": "2-5 words, lowercase noun phrase."},
            "choice": {"type": "string", "enum": ["receipt_shown", "location_tagged_or_shown", "timestamp_overlay", "find_shown_in_place", "none_visible", "other", "n/a"]}
          }}
      }
    },

    "confidence": {"type": "string", "enum": ["low", "med", "high"]}
  }
}
